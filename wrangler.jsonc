{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "practice-buddy",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything dynamic goes through the Worker first; the rest is static SPA.
    "run_worker_first": ["/api/*", "/audio/*", "/c/*", "/robots.txt"],
  },
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "practice-buddy-content" }],
  // The production custom domain is NOT here: vite.config.ts injects it at build time from
  // deployment.json (ADR-0012). It is owned by wrangler, not OpenTofu (see docs/deploy.md).
  "env": {
    "dev": {
      "name": "practice-buddy-dev",
      "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "practice-buddy-content-dev" }],
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
    },
  },
}
